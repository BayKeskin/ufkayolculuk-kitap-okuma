<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. İstek zaten public/ içerisindeyse döngüyü önle
    RewriteCond %{REQUEST_URI} (^|/)public/ [NC]
    RewriteRule ^ - [L]

    # 2. Ana dizindeki statik asset'leri (assets/, resimler vb.) doğrudan sun
    # HTML istekleri kesinlikle CodeIgniter'a yönlendirilir; statik HTML sunulmaz!
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteCond %{REQUEST_URI} !\.(html|htm)$ [NC]
    RewriteRule ^ - [L]

    # 3. Diğer tüm istekleri (dinamik rotalar, .html sayfaları, public altındaki asset'ler) public/'e yönlendir
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
