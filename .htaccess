<IfModule mod_rewrite.c>
    RewriteEngine On

    # Eğer public klasöründe gerçek dosya veya dizin varsa ona git (assets, images vs.)
    RewriteCond %{DOCUMENT_ROOT}/ufkayolculuk-kitap-okuma/public/$1 -f [OR]
    RewriteCond %{DOCUMENT_ROOT}/ufkayolculuk-kitap-okuma/public/$1 -d
    RewriteRule ^(.*)$ public/$1 [L]

    # Dinamik rotaları doğrudan public/index.php'ye ilet
    RewriteRule ^(.*)$ public/index.php [L,QSA]
</IfModule>
