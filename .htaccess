<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. İstek zaten public/ içerisindeyse döngüyü önle
    RewriteCond %{REQUEST_URI} (^|/)public/ [NC]
    RewriteRule ^ - [L]

    # 2. Ana dizinde doğrudan mevcut olan statik dosyaları (html vb.) doğrudan sun
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3. Diğer tüm istekleri (dinamik rotalar, public altındaki asset'ler) public/'e yönlendir
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
